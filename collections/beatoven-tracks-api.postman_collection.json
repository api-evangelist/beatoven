  "info": {
    "_postman_id": "2fd624d1-520a-4791-9e85-642277ded892",
    "name": "Beatoven Composition Tracks API",
    "description": "Public REST API for Beatoven.ai's text-to-music generation. Submit a natural language prompt and receive an asynchronously composed track with downloadable master mix and individual stems (bass, chords, melody, percussion). The API is asynchronous: POST a composition request to receive a task_id, then poll the task endpoint until status is \"composed\".\n\nContact Support:\n Name: Beatoven.ai Support\n Email: hello@beatoven.ai",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T03:10:17.000Z",
    "updatedAt": "2026-10-22T03:10:17.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-2fd624d1-520a-4791-9e85-642277ded892"
  },
